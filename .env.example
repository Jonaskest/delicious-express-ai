# Configurações da aplicação
APP_NAME=Delicious Express AI
DATABASE_URL=sqlite:///./delicious_express.db

# Google Gemini API (opcional — sem chave, o assistente opera em modo demo offline)
# Obtenha gratuitamente em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot API (opcional — sem token, notificações são registradas em log local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
